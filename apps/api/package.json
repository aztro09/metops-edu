{
  "name": "@metops/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:seed": "tsx --env-file=../../.env -- prisma/seed.ts",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "db:test:migrate": "dotenv -e .env.test -- prisma migrate deploy",
    "db:seed:prod": "node dist/seed.js",
    "db:reset": "dotenv -e ../../.env -- prisma migrate reset --force"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "fastify": "^5.12.7",
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "6.19.3",
    "file-type": "^22.2.0",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "prisma": "6.19.3",
    "prom-client": "^15.1.3",
    "socket.io": "^4.8.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "prisma": "^7.10.1",
    "@metops/shared": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "dotenv-cli": "^8.0.0",
    "pino-pretty": "^13.2.0",
    "socket.io-client": "^4.8.4",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  }
}

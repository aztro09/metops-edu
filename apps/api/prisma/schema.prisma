generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ Seguridad / usuarios ============
model Rol {
  id          Int          @id @default(autoincrement())
  nombre      String       @unique @map("name") @db.VarChar(30)
  descripcion String?      @map("description") @db.VarChar(150)
  usuarios    UsuarioRol[]

  @@map("roles")
}

model Usuario {
  id                 Int       @id @default(autoincrement())
  claveInstitucional String    @unique @map("institutional_id") @db.VarChar(20)
  nombre             String    @map("name") @db.VarChar(80)
  apellidos          String    @map("last_name") @db.VarChar(120)
  correo             String    @unique @map("email") @db.VarChar(150)
  passwordHash       String    @map("password_hash") @db.VarChar(255)
  activo             Boolean   @default(true) @map("active")
  creadoAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  ultimoAcceso       DateTime? @map("last_access_at") @db.Timestamptz(3)

  roles            UsuarioRol[]
  ticketsCreados   Ticket[]          @relation("Reportante")
  ticketsAsignados Ticket[]          @relation("Asignado")
  comentarios      Comentario[]
  evidencias       Evidencia[]
  historial        HistorialTicket[] @relation("HistorialAutor")
  notificaciones   Notificacion[]
  refreshTokens    RefreshToken[]

  @@map("users")
}

model UsuarioRol {
  usuarioId Int     @map("user_id")
  rolId     Int     @map("role_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  rol       Rol     @relation(fields: [rolId], references: [id])

  @@id([usuarioId, rolId])
  @@map("user_roles")
}

model RefreshToken {
  id         Int       @id @default(autoincrement())
  usuarioId  Int       @map("user_id")
  familia    String    @map("family") @db.VarChar(40)
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  expiraAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  usadoAt    DateTime? @map("used_at") @db.Timestamptz(3)
  revocadoAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  creadoAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([familia])
  @@map("refresh_tokens")
}

// ============ Infraestructura ============
model Edificio {
  id       Int       @id @default(autoincrement())
  codigo   String    @unique @map("code") @db.VarChar(10)
  nombre   String    @map("name") @db.VarChar(80)
  espacios Espacio[]

  @@map("buildings")
}

model Espacio {
  id         Int      @id @default(autoincrement())
  edificioId Int      @map("building_id")
  codigo     String   @map("code") @db.VarChar(20)
  nombre     String   @map("name") @db.VarChar(100)
  tipo       String   @map("type") @db.VarChar(15)
  piso       Int? @map("floor")
  mapaX      Decimal? @map("map_x") @db.Decimal(7, 2)
  mapaY      Decimal? @map("map_y") @db.Decimal(7, 2)
  activo     Boolean  @default(true) @map("active")
  edificio   Edificio @relation(fields: [edificioId], references: [id])
  equipos    Equipo[]
  tickets    Ticket[]

  @@unique([edificioId, codigo])
  @@map("spaces")
}

model Equipo {
  id                 Int      @id @default(autoincrement())
  espacioId          Int      @map("space_id")
  tipo               String   @map("type") @db.VarChar(20)
  etiquetaInventario String?  @unique @map("inventory_tag") @db.VarChar(40)
  descripcion        String?  @map("description") @db.VarChar(200)
  estadoOperativo    String   @default("OPERATIVO") @map("operational_status") @db.VarChar(15)
  espacio            Espacio  @relation(fields: [espacioId], references: [id])
  tickets            Ticket[]

  @@map("equipment")
}

// ============ Catálogos de tickets ============
model Categoria {
  id                Int      @id @default(autoincrement())
  nombre            String   @unique @map("name") @db.VarChar(60)
  descripcion       String?  @map("description") @db.VarChar(200)
  prioridadSugerida String   @default("MEDIA") @map("suggested_priority") @db.VarChar(10)
  activa            Boolean  @default(true) @map("active")
  tickets           Ticket[]

  @@map("categories")
}

model Estado {
  id      Int      @id @default(autoincrement())
  nombre  String   @unique @map("name") @db.VarChar(20)
  orden   Int@map("sort_order")
  esFinal Boolean  @default(false) @map("is_final")
  tickets Ticket[]

  @@map("statuses")
}

// ============ Tickets ============
model Ticket {
  id            Int       @id @default(autoincrement())
  folio         String    @unique @db.VarChar(20)
  titulo        String    @map("title") @db.VarChar(150)
  descripcion   String@map("description")
  categoriaId   Int       @map("category_id")
  espacioId     Int       @map("space_id")
  equipoId      Int?      @map("equipment_id")
  prioridad     String    @default("MEDIA") @map("priority") @db.VarChar(10)
  estadoId      Int       @map("status_id")
  reportanteId  Int       @map("reporter_id")
  asignadoId    Int?      @map("assignee_id")
  ticketPadreId Int?      @map("parent_ticket_id")
  creadoAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  reconocidoAt  DateTime? @map("acknowledged_at") @db.Timestamptz(3)
  resueltoAt    DateTime? @map("resolved_at") @db.Timestamptz(3)
  cerradoAt     DateTime? @map("closed_at") @db.Timestamptz(3)
  actualizadoAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  categoria  Categoria @relation(fields: [categoriaId], references: [id])
  espacio    Espacio   @relation(fields: [espacioId], references: [id])
  equipo     Equipo?   @relation(fields: [equipoId], references: [id])
  estado     Estado    @relation(fields: [estadoId], references: [id])
  reportante Usuario   @relation("Reportante", fields: [reportanteId], references: [id])
  asignado   Usuario?  @relation("Asignado", fields: [asignadoId], references: [id])
  padre      Ticket?   @relation("Duplicados", fields: [ticketPadreId], references: [id])
  hijos      Ticket[]  @relation("Duplicados")

  comentarios    Comentario[]
  evidencias     Evidencia[]
  historial      HistorialTicket[]
  notificaciones Notificacion[]
  resumenes      ResumenIa[]

  @@index([estadoId])
  @@index([espacioId, estadoId])
  @@index([reportanteId])
  @@index([asignadoId])
  @@index([creadoAt])
  @@map("tickets")
}

model Comentario {
  id         Int         @id @default(autoincrement())
  ticketId   Int         @map("ticket_id")
  autorId    Int         @map("author_id")
  contenido  String@map("content")
  esInterno  Boolean     @default(false) @map("is_internal")
  creadoAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  ticket     Ticket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  autor      Usuario     @relation(fields: [autorId], references: [id])
  evidencias Evidencia[]

  @@index([ticketId, creadoAt])
  @@map("comments")
}

model Evidencia {
  id            Int         @id @default(autoincrement())
  ticketId      Int         @map("ticket_id")
  comentarioId  Int?        @map("comment_id")
  subidoPor     Int         @map("uploaded_by")
  nombreArchivo String      @map("file_name") @db.VarChar(255)
  tipoMime      String      @map("mime_type") @db.VarChar(100)
  tamanoBytes   Int         @map("size_bytes")
  storageKey    String      @map("storage_key") @db.VarChar(255)
  creadoAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  ticket        Ticket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  comentario    Comentario? @relation(fields: [comentarioId], references: [id], onDelete: SetNull)
  autor         Usuario     @relation(fields: [subidoPor], references: [id])

  @@map("evidence")
}

model HistorialTicket {
  id                 Int      @id @default(autoincrement())
  ticketId           Int      @map("ticket_id")
  usuarioId          Int      @map("user_id")
  accion             String   @map("action") @db.VarChar(30)
  estadoAnteriorId   Int?     @map("previous_status_id")
  estadoNuevoId      Int?     @map("new_status_id")
  asignadoAnteriorId Int?     @map("previous_assignee_id")
  asignadoNuevoId    Int?     @map("new_assignee_id")
  detalle            Json? @map("detail")
  creadoAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  ticket             Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  usuario            Usuario  @relation("HistorialAutor", fields: [usuarioId], references: [id])

  @@index([ticketId, creadoAt])
  @@map("ticket_history")
}

model Notificacion {
  id        Int      @id @default(autoincrement())
  usuarioId Int      @map("user_id")
  ticketId  Int?     @map("ticket_id")
  tipo      String   @map("type") @db.VarChar(30)
  mensaje   String   @map("message") @db.VarChar(255)
  leida     Boolean  @default(false) @map("is_read")
  creadoAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  ticket    Ticket?  @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([usuarioId, leida, creadoAt(sort: Desc)])
  @@map("notifications")
}

model Auditoria {
  id        Int      @id @default(autoincrement())
  usuarioId Int      @map("user_id")
  accion    String   @map("action") @db.VarChar(40)
  entidad   String   @map("entity") @db.VarChar(40)
  entidadId String?  @map("entity_id") @db.VarChar(40)
  ip        String?  @db.VarChar(45)
  detalle   Json? @map("detail")
  creadoAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("audit_log")
}

model ResumenIa {
  id            Int      @id @default(autoincrement())
  ticketId      Int      @map("ticket_id")
  contenido     String@map("content")
  modelo        String   @map("model") @db.VarChar(60)
  solicitadoPor Int      @map("requested_by")
  creadoAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  ticket        Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, creadoAt(sort: Desc)])
  @@map("ai_summaries")
}

/// Contador de folios por año (MO-AAAA-00001). Se incrementa dentro de la transacción de crear ticket.
model FolioSecuencia {
  anio   Int @id @map("year")
  ultimo Int @default(0) @map("last_number")

  @@map("folio_sequence")
}

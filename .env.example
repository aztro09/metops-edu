# ---- Base de datos ----
DATABASE_URL=postgresql://metops:password@localhost:port/metops

# ---- API ----
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Mínimo 32 caracteres. Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambia-este-valor-por-uno-largo-y-aleatorio-de-32-o-mas
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=7
# true solo cuando se sirve por HTTPS (producción)
COOKIE_SECURE=false
EVIDENCE_DIR=./evidencias
MAX_UPLOAD_MB=5
LOGIN_RATE_MAX=10

# ---- Administrador inicial (lo crea el seed) ----
ADMIN_CORREO=admin@metops.local
ADMIN_PASSWORD=Cambiar.Esta.Clave.123
ADMIN_CLAVE=ADMIN0001
